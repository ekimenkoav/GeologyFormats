Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ZMAPGridImport", "[", 
    RowBox[{"path_String", "?", "FileExistsQ"}], "]"}], " ", "/;", " ", "\n", 
   "\t", 
   RowBox[{"StringMatchQ", "[", 
    RowBox[{
     RowBox[{"FileExtension", "[", "path", "]"}], ",", "\"\<zmap\>\""}], 
    "]"}]}], " ", ":=", " ", "\n", "\t", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "\n", "\t\t", 
     RowBox[{"stream", ",", " ", "line", ",", " ", "\n", "\t\t", 
      RowBox[{"comment", " ", "=", " ", 
       RowBox[{"{", "}"}]}], ",", " ", 
      RowBox[{"header", " ", "=", " ", 
       RowBox[{"{", "}"}]}], ",", " ", 
      RowBox[{"data", " ", "=", " ", 
       RowBox[{"{", "}"}]}], ",", " ", "\n", "\t\t", 
      RowBox[{"headerFlag", " ", "=", " ", "True"}], ",", " ", 
      RowBox[{"flagNum", "=", "0"}], ",", " ", 
      RowBox[{"position", "=", "0"}], ",", " ", "headerValues"}], "\n", "\t", 
     "}"}], ",", " ", "\n", "\t\t", 
    RowBox[{
     RowBox[{"stream", " ", "=", " ", 
      RowBox[{"OpenRead", "[", "path", "]"}]}], ";", "\n", "\t", "\n", "\t", 
     RowBox[{"While", "[", 
      RowBox[{"headerFlag", ",", " ", "\n", "\t\t\t", 
       RowBox[{
        RowBox[{"line", " ", "=", " ", 
         RowBox[{"ReadLine", "[", "stream", "]"}]}], ";", " ", "\n", "\t\t\t", 
        RowBox[{"position", "++"}], ";", "\n", "\t\t\t", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"ZMAPGridCommenStartQ", "[", "line", "]"}], ",", " ", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"comment", ",", " ", "line"}], "]"}]}], "]"}], ";", "\n", 
        "\t\t\t", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"ZMAPGridFlagQ", "[", "line", "]"}], ",", " ", 
          RowBox[{"flagNum", "=", 
           RowBox[{"flagNum", "+", "1"}]}]}], "]"}], ";", "\n", "\t\t\t\t", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"flagNum", ">", "0"}], " ", "&&", " ", 
           RowBox[{"flagNum", "<=", "2"}]}], ",", " ", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"header", ",", " ", "line"}], "]"}]}], "]"}], ";", " ", 
        "\n", "\t\t\t\t", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"flagNum", "==", "2"}], ",", 
          RowBox[{
           RowBox[{"headerFlag", "=", "False"}], ";", " ", 
           RowBox[{"Break", "[", "]"}], ";"}]}], "]"}], ";"}]}], " ", "\n", 
      "\t\t\t", "\n", "\t\t", "]"}], ";", "\n", "\n", "\t\t", 
     RowBox[{"position", " ", "=", " ", 
      RowBox[{"StringLength", "[", 
       RowBox[{"StringRiffle", "[", 
        RowBox[{
         RowBox[{"Join", "[", 
          RowBox[{"comment", ",", " ", "header"}], "]"}], ",", 
         " ", "\"\<\\n\>\""}], "]"}], "]"}]}], ";", "\n", "\t\t", 
     RowBox[{"SetStreamPosition", "[", 
      RowBox[{"stream", ",", " ", 
       RowBox[{"position", " ", "+", " ", "1"}]}], "]"}], ";", " ", "\n", 
     "\t\t", 
     RowBox[{"data", " ", "=", " ", 
      RowBox[{"ReadList", "[", 
       RowBox[{"stream", ",", " ", "Real"}], "]"}]}], ";", " ", "\n", "\t\t", 
     "\n", "\t\t", 
     RowBox[{"Close", "[", "stream", "]"}], ";", "\n", "\n", "\t\t", 
     RowBox[{"headerValues", " ", "=", " ", 
      RowBox[{"ZMAPGridHeader", "[", "header", "]"}]}], ";", "\n", "\n", 
     "\t\t", 
     RowBox[{"(*", "Return", "*)"}], "\n", "\t\t", 
     RowBox[{"<|", "\n", "\t\t\t", 
      RowBox[{
       RowBox[{"\"\<comment\>\"", " ", "->", " ", 
        RowBox[{"ZMAPGridComment", "[", "comment", "]"}]}], ",", " ", "\n", 
       "\t\t\t", 
       RowBox[{"\"\<header\>\"", " ", "->", " ", 
        RowBox[{"ZMAPGridHeader", "[", "header", "]"}]}], ",", " ", "\n", 
